Screen {
    layout: vertical;
}

#body {
    layout: horizontal;
    height: 1fr;
}

#code_view {
    width: 2fr;
    border: round green;
    padding: 1;
    overflow: auto;
}

#right_panel {
    width: 1fr;
    layout: vertical;
}

#details {
    height: 1fr;
    border: round blue;
    padding: 1;
    overflow: auto;
}

#watch_view {
    height: 1fr;
    border: round magenta;
    padding: 1;
    overflow: auto;
}

#timeline {
    height: 5;
    border: round yellow;
    padding: 1;
}